#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    /* ===================== MACROS ===================== */
    macros {
        /* === UNDERGLOW FLASH (nie zmienia stanu końcowego) === */
        flash1: flash1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 120>
                , <&macro_tap &rgb_ug RGB_TOG>;
        };

        flash2: flash2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 120>
                , <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 180>
                , <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 120>
                , <&macro_tap &rgb_ug RGB_TOG>;
        };

        flash3: flash3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 120>
                , <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 180>
                , <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 120>
                , <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 180>
                , <&macro_tap &rgb_ug RGB_TOG>
                , <&macro_wait_time 120>
                , <&macro_tap &rgb_ug RGB_TOG>;
        };

        /* === AKCJE + FLASH === */
        out_tog_and_flash: out_tog_and_flash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap &out OUT_TOG>
                , <&macro_tap &flash1>;
        };

        bt_clr_and_flash: bt_clr_and_flash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap &bt BT_CLR>
                , <&macro_tap &flash2>;
        };

        soft_off_warn_and_go: soft_off_warn_and_go {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap &flash3>
                , <&macro_tap &soft_off>;
        };
    };

    /* ===================== BEHAVIORS ===================== */
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp &kp>;
            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                39 40 41
            >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp &kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38
            >;
            hold-trigger-on-release;
        };

        /* === HOLD 3s / TAP INFO === */
        out_tog_3s: out_tog_3s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <3000>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            bindings = <&out_tog_and_flash &flash1>;
        };

        bt_clr_3s: bt_clr_3s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <3000>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            bindings = <&bt_clr_and_flash &flash2>;
        };

        soft_off_3s: soft_off_3s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <3000>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            bindings = <&soft_off_warn_and_go &flash3>;
        };
    };

    /* ===================== KEYMAP ===================== */
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB    &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
                &kp LCTRL  &hml LGUI A  &hml LCTRL S &hml LALT D &hml LSHFT F &kp G        &kp H        &hmr RSHFT J &hmr RALT K &hmr RCTRL L &hmr RGUI SEMI &kp SQT
                &kp LSHFT  &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
                                         &kp LGUI     &mo 1        &kp SPACE   &kp ENTER   &mo 2        &kp RALT
            >;
        };

        lower_layer { /* bez zmian */ };

        raise_layer { /* bez zmian */ };

        adjust_layer { /* bez zmian */ };

        /* ===================== LAYER 4 ===================== */
        layer_4 {
            bindings = <
                &bt_clr_3s      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &none        &out_tog_3s
                &none           &none           &none           &none           &none        &soft_off_3s

                &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_HUI &rgb_ug RGB_HUD &none
                &none           &none           &none           &none           &none           &none

                &none           &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_EFF &rgb_ug RGB_EFR &none
                &none           &none           &none           &none           &none           &none

                                   &none           &to 0           &none           &none           &none           &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_condition {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

&mmv { time-to-max-speed-ms = <500>; };
&msc { time-to-max-speed-ms = <300>; };
