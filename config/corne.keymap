#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        /* 1x flash — krótkie potwierdzenie */
        flash1: flash1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <120>;
            tap-ms = <0>;
            bindings = <&rgb_ug RGB_TOG &rgb_ug RGB_TOG>;
        };

        /* 2x flash — potwierdzenie BT clear */
        flash2: flash2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <120>;
            tap-ms = <0>;
            bindings =
                <&rgb_ug RGB_TOG &rgb_ug RGB_TOG
                 &rgb_ug RGB_TOG &rgb_ug RGB_TOG>;
        };

        /* 3x flash — ostrzeżenie przed soft_off */
        flash3: flash3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <120>;
            tap-ms = <0>;
            bindings =
                <&rgb_ug RGB_TOG &rgb_ug RGB_TOG
                 &rgb_ug RGB_TOG &rgb_ug RGB_TOG
                 &rgb_ug RGB_TOG &rgb_ug RGB_TOG>;
        };

        /* 0 = OUT_TOG (toggle USB/BLE) */
        out_tog_flash: out_tog_flash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out 0 &flash1>;
        };

        bt_clr_flash: bt_clr_flash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR &flash2>;
        };

        soft_off_flash: soft_off_flash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&flash3 &soft_off>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp &kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp &kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        /* 3s hold = akcja, tap = tylko flash */
        out_tog_3s: out_tog_3s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            hold-trigger-on-release;
            bindings = <&out_tog_flash &flash1>;
        };

        bt_clr_3s: bt_clr_3s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            hold-trigger-on-release;
            bindings = <&bt_clr_flash &flash2>;
        };

        soft_off_3s: soft_off_3s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            hold-trigger-on-release;
            bindings = <&soft_off_flash &flash3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB    &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P           &kp BSPC
                &kp LCTRL  &hml LGUI A  &hml LCTRL S &hml LALT D  &hml LSHFT F &kp G        &kp H        &hmr RSHFT J &hmr RALT K  &hmr RCTRL L  &hmr RGUI SEMI  &kp SQT
                &kp LSHFT  &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH        &kp RSHFT
                                         &kp LGUI     &mo 1        &kp SPACE    &kp ENTER    &mo 2        &kp RALT
            >;
        };

        lower_layer {
            bindings = <
                &kp ESC    &none                &kp N7 &kp N8 &kp N9 &kp PG_UP  &kp LG(LS(J))      &kp LC(LS(TAB))  &kp LC(TAB) &none     &none                 &kp DEL
                &kp LCTRL  &none                &kp N4 &kp N5 &kp N6 &kp PG_DN  &kp LEFT           &kp DOWN         &kp UP      &kp RIGHT &none                 &kp RCTRL
                &kp LSHFT  &kp LC(LS(LA(LGUI))) &kp N1 &kp N2 &kp N3 &kp N0     &kp C_VOL_DN       &kp C_VOL_UP     &none       &none     &kp LC(LS(LA(LGUI)))  &kp LG(LSHFT)
                                               &kp LGUI &mo 1 &kp SPACE &kp LG(LA(SPACE)) &mo 2               &kp RALT
            >;
        };

        raise_layer {
            bindings = <
                &kp GRAVE  &kp EXCL             &kp AT   &kp HASH &kp DLLR &kp PRCNT     &kp CARET &kp AMPS &kp STAR &kp PLUS &kp EQUAL            &kp MINUS
                &kp LCTRL  &none                &kp LBRC &kp LPAR &kp LBKT &kp SQT       &kp DQT   &kp RBKT &kp RPAR &kp RBRC &kp BSLH             &kp RCTRL
                &kp LSHFT  &kp LC(LS(LA(LGUI))) &none    &none    &none    &none         &kp UNDER &none    &none    &none    &kp LC(LS(LA(LGUI))) &kp RSHFT
                                               &kp LGUI &mo 1   &kp LC(SPACE) &kp SPACE &mo 2    &kp RALT
            >;
        };

        adjust_layer {
            bindings = <
                &kp LC(LS(ESC)) &to 4 &kp F7 &kp F8 &kp F9 &kp F12 &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none                &kp PSCRN
                &none           &none &kp F4 &kp F5 &kp F6 &kp F11 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none                &kp RCTRL
                &none           &none &kp F1 &kp F2 &kp F3 &kp F10 &mkp LCLK      &mkp RCLK      &mkp MCLK    &none           &kp LC(LS(LA(LGUI))) &kp RSHFT
                                 &kp LGUI &mo 1 &none   &none          &mo 2          &kp RALT
            >;
        };

        layer_4 {
            bindings = <
                &bt_clr_3s 0 0     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &none              &out_tog_3s 0 0    &none &none &none &none &none &none
                &none              &none           &none           &none           &none              &soft_off_3s 0 0     &none &none &none &none &none &none
                &rgb_ug RGB_TOG    &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_HUI &rgb_ug RGB_HUD    &none              &none &none &none &none &none &none
                                                     &none         &to 0           &none              &none              &none &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_condition {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

&mmv { time-to-max-speed-ms = <500>; };
&msc { time-to-max-speed-ms = <300>; };
